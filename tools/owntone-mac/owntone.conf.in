# OwnTone config for the Mac test setup (Phase 3). Generated into .local/owntone/owntone.conf
# by run.sh — edit this template, not the generated file.
# Every key here was checked against OwnTone 29.3 src/conffile.c; defaults are left out.

general {
	uid = "@USER@"
	db_path = "@DATA@/songs3.db"
	cache_dir = "@DATA@/cache"
	logfile = "@DATA@/owntone.log"
	# fatal, log, warning, info, debug, spam
	loglevel = @LOGLEVEL@
}

library {
	name = "wormhole on %h"
	port = @PORT@
	# First dir holds the PCM pipe; second makes tools/media playable for the local-file test.
	directories = { "@PIPE_DIR@", "@MEDIA@" }
	# OwnTone's defaults plus .md (tools/media/README.md is not audio).
	filetypes_ignore = { ".db", ".ini", ".db-journal", ".pdf", ".metadata", ".md" }

	# Start playback as soon as data arrives in a named pipe in the library.
	pipe_autostart = true
	# Must match what `wormhole feed` writes (PIPE_SAMPLE_RATE / PIPE_BITS in config/*.env).
	# OwnTone accepts 44100, 48000, 88200, 96000 and 16 or 32 bits; always 2 channels.
	pipe_sample_rate = @PIPE_SAMPLE_RATE@
	pipe_bits_per_sample = @PIPE_BITS@
}

#!/bin/sh
# Launcher that works identically on the Mac and on the NAS (POSIX sh, no install step).
# Config: $WORMHOLE_ENV if set, else config/active.env (deployed), else config/local.env.
set -e
ROOT=$(cd "$(dirname "$0")/.." && pwd)
if [ -z "$WORMHOLE_ENV" ]; then
    if [ -f "$ROOT/config/active.env" ]; then
        WORMHOLE_ENV="$ROOT/config/active.env"
    else
        WORMHOLE_ENV="$ROOT/config/local.env"
    fi
fi
export WORMHOLE_ENV
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "${WORMHOLE_PYTHON:-python3}" -m wormhole "$@"

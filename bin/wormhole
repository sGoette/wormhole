#!/bin/sh
# Launcher that works identically on the Mac and on the server (POSIX sh, no install step).
# Config: $WORMHOLE_ENV if set, else /etc/wormhole/wormhole.env (server), else config/local.env.
set -e
ROOT=$(cd "$(dirname "$0")/.." && pwd)
if [ -z "$WORMHOLE_ENV" ]; then
    if [ -f /etc/wormhole/wormhole.env ]; then
        WORMHOLE_ENV=/etc/wormhole/wormhole.env
    else
        WORMHOLE_ENV="$ROOT/config/local.env"
    fi
fi
export WORMHOLE_ENV
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "${WORMHOLE_PYTHON:-python3}" -m wormhole "$@"

# Settings used when running on the Mac (make run / make test).
# Same keys as nas.env.example — only values differ.
# Relative paths are relative to the repo root.

# Port the fake turntable / stream server listens on (STRATEGY.md default)
STREAM_PORT=8765

# OwnTone JSON API (Phase 3: locally built OwnTone, see tools/owntone-mac/)
OWNTONE_URL=http://localhost:3689

# Named pipe OwnTone reads raw PCM from. Must sit inside an OwnTone library directory.
PCM_PIPE=.local/owntone/library/turntable
# PCM format written by `wormhole feed`; must match pipe_sample_rate / pipe_bits_per_sample
# in the OwnTone config (OwnTone defaults: 44100 / 16).
PIPE_SAMPLE_RATE=44100
PIPE_BITS=16

# What `wormhole feed` plays when --input is not given: tone, a file path, or a stream URL
# (e.g. the fake turntable: http://localhost:8765/live/tone/stream.mp3)
FEED_INPUT=tone

LOG_LEVEL=DEBUG

# Settings used when running on the Mac (make run / make test).
# Same keys as nas.env.example — only values differ.

# Port the fake turntable / stream server listens on (STRATEGY.md default)
STREAM_PORT=8765

# OwnTone HTTP API (Phase 3: local OwnTone on the Mac, if used)
OWNTONE_URL=http://localhost:3689

# Where the bridge writes raw PCM for OwnTone (verify OwnTone's pipe config before relying on this)
PCM_PIPE=/tmp/wormhole.pcm

LOG_LEVEL=DEBUG

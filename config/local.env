# Settings used when running on the Mac (make run / make test).
# Same keys as server/wormhole.env.example (the server's /etc/wormhole/wormhole.env).
# Relative paths are relative to the repo root.

# Port the fake turntable / stream server listens on (STRATEGY.md default)
STREAM_PORT=8765

# OwnTone JSON API (Phase 3: locally built OwnTone, see tools/owntone-mac/)
OWNTONE_URL=http://localhost:3689
# OwnTone's log; the web UI shows the reason from it when OwnTone answers "400 Bad Request".
OWNTONE_LOG=.local/owntone/var/owntone.log

# Named pipe OwnTone reads raw PCM from. Must sit inside an OwnTone library directory.
PCM_PIPE=.local/owntone/library/turntable
# PCM format written by `wormhole feed`; must match pipe_sample_rate / pipe_bits_per_sample
# in the OwnTone config (OwnTone defaults: 44100 / 16).
PIPE_SAMPLE_RATE=44100
PIPE_BITS=16

# What `wormhole feed` plays when --input is not given: tone, a file path, or a stream URL
# (e.g. the fake turntable: http://localhost:8765/live/tone/stream.mp3)
FEED_INPUT=tone
# Extra suggestions in the web UI's feed field (comma-separated). Files in tools/media are
# added automatically on the Mac.
FEED_PRESETS=http://localhost:8765/live/tone/stream.mp3

# Port of `wormhole web` (speakers, volumes, feed). Reachable from the iPhone on the LAN.
WEB_PORT=8766

# UPnP renderer started by `wormhole web` (the "speaker" the turntable streams to).
# Empty RENDERER_NAME = no renderer. RENDERER_IP: only if auto-detection picks the wrong
# interface.
RENDERER_NAME="Wormhole (Mac)"
RENDERER_PORT=49494
RENDERER_IP=

# Updates from the web UI (Software panel). On the Mac they are refused while the checkout
# has local changes or unpushed commits.
UPDATE_REMOTE=origin
UPDATE_BRANCH=main

LOG_LEVEL=DEBUG

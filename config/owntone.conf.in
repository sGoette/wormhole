# OwnTone config for wormhole. Rendered by `wormhole owntone-config` (src/wormhole/owntoneconf.py)
# for the Mac (tools/owntone-mac/run.sh) and the server (server/install.sh).
# Edit this template, not a generated file. Every key was checked against OwnTone 29.4
# src/conffile.c; OwnTone's defaults are left out (except where a comment says why).

general {
	uid = "@USER@"
	db_path = "@DB_PATH@"
	cache_dir = "@CACHE_DIR@"
	logfile = "@LOGFILE@"
	# fatal, log, warning, info, debug, spam
	loglevel = @LOGLEVEL@
}

# Settings for all AirPlay speakers (OwnTone 29.4 src/conffile.c, sec_airplay_shared).
airplay_shared {
	# HomePod software 27 answers 403 to OwnTone's own User-Agent ("owntone/29.3").
	# Verified 2026-11-13 on a HomePod: 403 with the default, 200 with this value.
	# OwnTone issue #2042. Since 29.4 this is the default and it lives here; in 29.3 it was
	# general.user_agent. Kept explicit so the fix stays if the default changes.
	user_agent = "AirPlay/999.0.0"
	# mediaremote (default true, new in 29.4) sends "now playing" (title, artwork, state)
	# the way an iPhone does to receivers that support it (HomePod, Apple TV).
}

library {
	name = "@NAME@"
	port = @PORT@
	# The first directory holds the PCM pipe. On the Mac, tools/media is added for local tests.
	directories = { @DIRECTORIES@ }
	# OwnTone's defaults plus .md (tools/media/README.md is not audio).
	filetypes_ignore = { ".db", ".ini", ".db-journal", ".pdf", ".metadata", ".md" }

	# On, although wormhole starts the pipe itself (play_pipe, just before the first audio, so
	# OwnTone finds it "already playing" and keeps wormhole's "now playing" info). OwnTone 29.4
	# only reads the pipe's .metadata FIFO (the record chosen in the web UI, mid-stream) with
	# autostart on: its read event lives in the autostart watcher (inputs/pipe.c,
	# evbase_pipe; RESULTS.md 2026-11-27). The watcher also keeps the pipe open, so a pause
	# stays paused instead of the feed restarting.
	pipe_autostart = true
	# Must match what `wormhole feed` writes (PIPE_SAMPLE_RATE / PIPE_BITS in the env file).
	# OwnTone accepts 44100, 48000, 88200, 96000 and 16 or 32 bits; always 2 channels.
	pipe_sample_rate = @PIPE_SAMPLE_RATE@
	pipe_bits_per_sample = @PIPE_BITS@

	# Per-track artwork. wormhole sets the pipe's "now playing" image on its queue item
	# (artwork_url = file:..., NOW_PLAYING_ARTWORK). OwnTone 29.4 src/artwork.c only looks at
	# a track's own artwork when this is on; otherwise it tries the album, and the pipe has none.
	artwork_individual = true
}

# OwnTone's own sound output ("Computer", ALSA/PulseAudio). The server VM has no sound card,
# so the speaker could never be switched on ("laudio: cannot find card '0'"). Only AirPlay
# speakers are used. Verified in OwnTone 29.4 src/outputs/alsa.c, pulse.c and pipewire.c:
# any type other than "alsa" / "pulseaudio" / "pipewire" keeps them from starting.
audio {
	type = "disabled"
}

# Copy to config/nas.env and fill in. config/nas.env is git-ignored.
#
# --- Deploy settings (read by deploy/deploy.sh on the Mac) ---------------

# SSH target for the NAS host (or a jail with sshd). Put keys in ~/.ssh/config.
NAS_SSH=user@nas.local

# Where releases live on the NAS. Recommended: a host dir nullfs-mounted into the jails
# (see nas/jails/README.md).
NAS_PATH=/usr/local/wormhole

# Python on the NAS (FreeBSD ports usually installs e.g. python3.11 — check with `ls /usr/local/bin/python3*`)
NAS_PYTHON=python3

# Command run on the NAS after switching 'current'. Leave empty until a service exists.
# Example later: RESTART_CMD="sudo service wormhole restart"
RESTART_CMD=

# Log file shown by `make nas-logs`
NAS_LOG=/var/log/wormhole.log

# How many old releases to keep for rollback
KEEP_RELEASES=5

# --- Runtime settings (read by the wormhole package on the NAS) ----------

STREAM_PORT=8765
OWNTONE_URL=http://localhost:3689
# Must sit inside an OwnTone library directory (path as seen from where feed runs).
PCM_PIPE=/var/db/owntone/library/turntable
PIPE_SAMPLE_RATE=44100
PIPE_BITS=16
FEED_INPUT=tone
LOG_LEVEL=INFO

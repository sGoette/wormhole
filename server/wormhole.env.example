# wormhole settings on the server (Debian VM).
# install.sh copies this to /etc/wormhole/wormhole.env once and never overwrites it.
# Same keys as config/local.env on the Mac; only values differ.
# After editing: systemctl restart wormhole   (and re-run install.sh for pipe/OwnTone keys)

# Web UI (speakers, volumes, settings, updates). Open http://<vm-name>.local:8766
WEB_PORT=8766

# UPnP renderer = the "speaker" the turntable (Pro-Ject Control app) streams to.
# Default name; it can be renamed in the web UI (settings). Empty = no renderer.
RENDERER_NAME=Wormhole
RENDERER_PORT=49494
# Only if auto-detection picks the wrong interface: the VM's LAN address.
RENDERER_IP=

# "Now playing" artwork OwnTone sends to AirPlay devices with a screen (Apple TV), as a path
# OwnTone can read (needs `artwork_individual = true` in the OwnTone config). Empty = none.
NOW_PLAYING_ARTWORK=src/wormhole/frontend/icons/now-playing.jpg

# Settings changed in the web UI (renderer name); a value there wins over this file.
# Must be writable by the user running `wormhole web`.
SETTINGS_FILE=/var/lib/wormhole/settings.json

# OwnTone (installed by install.sh, same machine)
OWNTONE_URL=http://localhost:3689
OWNTONE_LOG=/var/log/owntone.log

# Named pipe OwnTone reads raw PCM from; must sit inside OwnTone's library directory.
PCM_PIPE=/var/lib/wormhole/library/turntable
# PCM format; must match pipe_sample_rate / pipe_bits_per_sample in /etc/owntone.conf
# (install.sh renders that file from these values).
PIPE_SAMPLE_RATE=44100
PIPE_BITS=16

# What `wormhole feed` (console test tool) plays without --input: tone, file or stream URL
FEED_INPUT=tone

# Updates from the web UI: fast-forward to the newest commit of this branch on GitHub.
UPDATE_REMOTE=origin
UPDATE_BRANCH=main

LOG_LEVEL=INFO
